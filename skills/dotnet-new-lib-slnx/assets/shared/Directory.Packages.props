<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- Resolve each package-specific version placeholder to the latest stable listed NuGet.org version at generation time. -->
  <ItemGroup>
    <PackageVersion Include="Codebelt.Extensions.Xunit.App" Version="{CODEBELT_EXTENSIONS_XUNIT_APP_VERSION}" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="{MICROSOFT_NET_TEST_SDK_VERSION}" />
    <PackageVersion Include="MinVer" Version="{MINVER_VERSION}" />
    <PackageVersion Include="coverlet.collector" Version="{COVERLET_COLLECTOR_VERSION}" />
    <PackageVersion Include="coverlet.msbuild" Version="{COVERLET_MSBUILD_VERSION}" />
    <PackageVersion Include="xunit.v3" Version="{XUNIT_V3_VERSION}" />
    <PackageVersion Include="xunit.v3.runner.console" Version="{XUNIT_V3_RUNNER_CONSOLE_VERSION}" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="{XUNIT_RUNNER_VISUALSTUDIO_VERSION}" />
    <PackageVersion Include="BenchmarkDotNet" Version="{BENCHMARKDOTNET_VERSION}" />
    <PackageVersion Include="BenchmarkDotNet.Diagnostics.Windows" Version="{BENCHMARKDOTNET_DIAGNOSTICS_WINDOWS_VERSION}" />
    <PackageVersion Include="Codebelt.Extensions.BenchmarkDotNet.Console" Version="{CODEBELT_EXTENSIONS_BENCHMARKDOTNET_CONSOLE_VERSION}" />
  </ItemGroup>
</Project>
