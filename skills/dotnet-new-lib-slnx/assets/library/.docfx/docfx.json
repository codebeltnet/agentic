{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "{PROJECT_NAME}/**.csproj"
          ],
          "src": "../src"
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "properties": {
        "TargetFramework": "{DOCFX_TARGET_FRAMEWORK}"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**/*.yml",
          "packages/**/*.md",
          "toc.yml",
          "*.md"
        ],
        "exclude": [
          "bin/**",
          "obj/**",
          "wwwroot/**",
          "api/namespaces/**",
          "api/types/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "globalMetadata": {
      "_appTitle": "{SOLUTION_NAME} by {COMPANY_OR_PERSON}",
      "_appFooter": "<span>Generated by <strong>DocFX</strong>. Copyright {COPYRIGHT_YEAR} {COMPANY_OR_PERSON}. All rights reserved.</span>",
      "_appLogoPath": "images/50x50.png",
      "_appFaviconPath": "images/favicon.ico",
      "_enableSearch": false,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "{REPOSITORY_URL}",
        "branch": "main"
      },
      "_gitUrlPattern": "github"
    },
    "dest": "wwwroot",
    "template": [
      "default",
      "modern"
    ],
    "overwrite": [
      {
        "files": [
          "api/namespaces/**/*.md",
          "api/types/**/*.md"
        ],
        "exclude": [
          "bin/**",
          "obj/**",
          "wwwroot/**"
        ]
      }
    ],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
}
