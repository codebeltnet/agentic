<Project>
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><IsTestProject>$(MSBuildProjectName.EndsWith('Tests'))</IsTestProject></PropertyGroup>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'"><OutputType>Exe</OutputType><UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner></PropertyGroup>
</Project>

