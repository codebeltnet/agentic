<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" Sdk="Microsoft.Docker.Sdk">
  <PropertyGroup Label="Globals">
    <ProjectVersion>2.1</ProjectVersion>
    <DockerTargetOS>Linux</DockerTargetOS>
    <ProjectGuid>{ProjectGuid}</ProjectGuid>
    <DockerComposeBaseFilePath>compose.assets</DockerComposeBaseFilePath>
    <DockerDevelopmentMode>Regular</DockerDevelopmentMode>
    <DockerLaunchAction>LaunchBrowser</DockerLaunchAction>
    <DockerServiceName>web-app</DockerServiceName>
    <DockerServiceUrl>http://localhost:{WebHostPort}</DockerServiceUrl>
  </PropertyGroup>
  <ItemGroup>
    <None Include="compose.assets.yml" />
    <None Include=".dockerignore" />
  </ItemGroup>
</Project>
